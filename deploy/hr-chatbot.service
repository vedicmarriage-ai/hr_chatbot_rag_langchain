[Unit]
Description=HR RAG chatbot (FastAPI on 127.0.0.1:8010)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/dev/hr_chatbot_rag_langchain
EnvironmentFile=-/home/dev/hr_chatbot_rag_langchain/.env
ExecStart=/home/dev/hr_chatbot_rag_langchain/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
